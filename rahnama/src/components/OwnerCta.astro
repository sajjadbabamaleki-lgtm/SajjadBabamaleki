---
import Icon from './Icon.astro';
interface Props { title?: string; text?: string }
const {
  title = 'کسب‌وکار ایرانی دارید؟',
  text = 'رایگان ثبت کنید تا ایرانیان شهرتان پیدایتان کنند. با ثبت ویژه، بالای فهرست و با قاب طلایی دیده شوید.',
} = Astro.props;
---
<section class="cta">
  <div class="pattern" aria-hidden="true"></div>
  <div class="body">
    <h2>{title}</h2>
    <p>{text}</p>
    <div class="buttons">
      <a class="btn btn-light" href="/business-add/"><Icon name="plus" />ثبت رایگان</a>
      <a class="btn btn-outline-light" href="/featured/"><Icon name="star" />درباره‌ی ثبت ویژه</a>
    </div>
  </div>
</section>
<style>
  .cta { position: relative; overflow: hidden; border-radius: var(--radius-lg); background: var(--color-primary-strong); color: var(--color-on-primary); display: grid; }
  .pattern { position: absolute; inset: 0; background: url('/tile-dark.svg') 0 0 / 64px 64px; mask-image: linear-gradient(to left, #000 0%, transparent 70%); -webkit-mask-image: linear-gradient(to left, #000 0%, transparent 70%); }
  .body { position: relative; padding: var(--space-6) var(--space-5); max-width: 40rem; }
  h2 { font-size: var(--text-2xl); color: #fff; }
  p { color: rgb(255 255 255 / 88%); }
  .buttons { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .btn-light { background: #fff; color: var(--color-primary-strong); }
  .btn-light:hover { background: var(--color-primary-soft); color: var(--color-primary-strong); }
  .btn-outline-light { border-color: rgb(255 255 255 / 70%); color: #fff; }
  .btn-outline-light:hover { background: rgb(255 255 255 / 12%); color: #fff; }
  @media (min-width: 768px) { .body { padding: var(--space-8) var(--space-7); } }
</style>
