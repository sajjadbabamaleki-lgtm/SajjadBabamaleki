---
// کارت کسب‌وکار «پوستر»: عکس تمام‌قد با نسبت ۴:۵، اسم درشت روی عکس، نشان سایت بالای کارت (قابل استوری)
import Icon from './Icon.astro';
import ShareButton from './cards/ShareButton.astro';
import Brandmark from './cards/Brandmark.astro';
import { cardData } from './cards/props';
import type { Business } from '../lib/data';
interface Props { business: Business }
const d = cardData(Astro.props.business);
const { b } = d;
---
<article class:list={['c6', { featured: d.featured }]} data-hood={b.neighborhood}>
  {d.cover ? <img class="bg" src={d.cover} alt="" width="900" height="1125" loading="lazy" /> : <div class="bg fallback" />}
  <div class="scrim" aria-hidden="true"></div>
  <header>
    <Brandmark />
    <ShareButton url={d.url} title={b.nameFa} class="share" />
  </header>
  <div class="content">
    <div class="tags">
      {d.featured && <span class="flag"><Icon name="star" size={14} />ویژه</span>}
      <span class="cat"><Icon name={d.category.icon} size={15} />{d.category.name}</span>
      {b.verified && <span class="ver"><Icon name="badge-check" size={15} />تأییدشده</span>}
    </div>
    <h3><a href={d.url}>{b.nameFa}</a></h3>
    <p class="loc"><Icon name="map-pin" size={16} />{b.neighborhood}، {d.city}</p>
    <div class="actions">
      <a class="call" href={d.tel}><Icon name="phone" />تماس</a>
      {d.wa && <a class="wa" href={d.wa} rel="noopener"><Icon name="message-circle" />واتساپ</a>}
    </div>
  </div>
</article>
<style>
  .c6 { position: relative; isolation: isolate; width: 100%; max-width: 420px; aspect-ratio: 4 / 5; border-radius: 28px; overflow: hidden; color: #fff; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 30px 60px -28px rgb(11 18 41 / 55%); }
  .c6.featured { box-shadow: 0 0 0 3px var(--color-featured), 0 30px 60px -28px rgb(122 86 0 / 55%); }
  .bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease-out); }
  .c6:hover .bg { transform: scale(1.04); }
  .fallback { background: var(--color-primary-strong) url('/tile-dark.svg') 0 0 / 64px 64px; }
  .scrim { position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgb(11 18 41 / 96%) 0%, rgb(11 18 41 / 75%) 34%, rgb(11 18 41 / 0%) 62%), linear-gradient(to bottom, rgb(11 18 41 / 55%), transparent 22%); }
  header { display: flex; align-items: center; justify-content: space-between; padding: 16px 16px 0 20px; }
  .c6 :global(.share) { width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgb(255 255 255 / 30%); background: rgb(11 18 41 / 35%); color: #fff; display: grid; place-items: center; cursor: pointer; backdrop-filter: blur(8px); }
  .content { padding: 18px 20px 20px; display: grid; gap: 6px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags span { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 99px; font-size: .8rem; font-weight: 700; background: rgb(255 255 255 / 16%); backdrop-filter: blur(8px); }
  .tags .flag { background: var(--color-featured); color: #fff; }
  .tags .ver { color: #c9d6ff; }
  h3 { margin: 2px 0 0; font-size: clamp(1.5rem, 1.1rem + 1.6vw, 1.9rem); line-height: 1.25; font-weight: 900; }
  h3 a { color: #fff; text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .loc { margin: 0; display: inline-flex; align-items: center; gap: 4px; color: rgb(255 255 255 / 82%); }
  .actions { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
  .actions a { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 50px; border-radius: 99px; font-weight: 800; text-decoration: none; }
  .call { background: #fff; color: var(--color-primary-strong); }
  .call:hover { background: var(--color-primary-soft); color: var(--color-primary-strong); }
  .wa { border: 1px solid rgb(255 255 255 / 45%); color: #fff; background: rgb(255 255 255 / 10%); backdrop-filter: blur(8px); }
  .wa:hover { background: rgb(255 255 255 / 20%); color: #fff; }
  .actions a:only-child { grid-column: 1 / -1; }
</style>
