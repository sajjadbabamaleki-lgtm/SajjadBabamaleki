---
import Icon from './Icon.astro';
import Avatar from './Avatar.astro';
import { businessUrl, getCategory, isFeatured, telHref, whatsappHref, type Business } from '../lib/data';
interface Props { business: Business; showCity?: string }
const { business: b, showCity } = Astro.props;
const featured = isFeatured(b);
const url = businessUrl(b);
---
<article class:list={['card', { featured }]} data-hood={b.neighborhood}>
  {featured && <span class="badge-featured ribbon"><Icon name="star" />ویژه · آگهی</span>}
  <div class="top">
    <Avatar name={b.nameFa} logo={b.logo} featured={featured} onTint={featured} />
    <div class="head">
      <h3><a href={url}>{b.nameFa}</a></h3>
      <p class="meta">
        <span>{b.categories.map((c) => getCategory(c).name).join('، ')}</span>
        <span class="dot" aria-hidden="true">•</span>
        <span><Icon name="map-pin" size={15} />{b.neighborhood}{showCity && `، ${showCity}`}</span>
      </p>
      {b.verified && <span class="badge-verified"><Icon name="badge-check" />تأییدشده</span>}
    </div>
  </div>
  <p class="desc">{b.description}</p>
  {b.languages.length > 0 && (
    <ul class="langs" aria-label="زبان‌های گفتگو">
      {b.languages.map((l) => <li class="chip">{l}</li>)}
    </ul>
  )}
  <div class="actions">
    <a class="btn btn-primary" href={telHref(b.phone)}><Icon name="phone" />تماس</a>
    {b.whatsapp && <a class="btn btn-ghost" href={whatsappHref(b.whatsapp)} rel="noopener"><Icon name="message-circle" />واتساپ</a>}
    <a class="more" href={url}>جزئیات<Icon name="arrow-left" size={18} /></a>
  </div>
</article>
<style>
  .card { position: relative; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out); }
  .card:hover { border-color: var(--color-primary); box-shadow: var(--shadow-lift); }
  .card.featured { border: 2px solid var(--color-featured); background: linear-gradient(var(--color-featured-soft), var(--color-featured-soft)) top / 100% 72px no-repeat, var(--color-bg); padding-top: var(--space-6); }
  .card.featured:hover { border-color: var(--color-featured-text); }
  .ribbon { position: absolute; top: -14px; inset-inline-start: var(--space-5); background: var(--color-bg); }
  .top { display: flex; gap: var(--space-4); align-items: flex-start; }
  .head { min-width: 0; display: grid; gap: var(--space-1); }
  h3 { margin: 0; font-size: var(--text-lg); }
  h3 a { color: var(--color-text); text-decoration: none; }
  h3 a:hover { color: var(--color-primary); }
  /* کل کارت با لینک عنوان قابل کلیک است */
  h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .meta { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-2); color: var(--color-muted); font-size: var(--text-sm); }
  .meta span { display: inline-flex; align-items: center; gap: 2px; }
  .dot { opacity: .5; }
  .desc { margin: 0; color: var(--color-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .langs { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .actions { position: relative; z-index: 1; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin-top: auto; padding-top: var(--space-2); }
  .actions .btn { min-height: 44px; padding-inline: var(--space-4); }
  .more { margin-inline-start: auto; display: inline-flex; align-items: center; gap: var(--space-1); font-weight: 700; text-decoration: none; min-height: 44px; }
</style>
