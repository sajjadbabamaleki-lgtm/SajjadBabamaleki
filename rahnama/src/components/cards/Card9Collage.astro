---
// طرح ۹ «کلاژ»: سه عکس کنار هم، ستاره‌ی لوگو روی مرز عکس‌ها
import Icon from '../Icon.astro';
import ShareButton from './ShareButton.astro';
import Brandmark from './Brandmark.astro';
import { cardData } from './props';
import type { Business } from '../../lib/data';
interface Props { business: Business }
const d = cardData(Astro.props.business);
const { b } = d;
const pics = [0, 1, 2].map((i) => d.photos[i] ?? d.photos[0] ?? '');
---
<article class:list={['c9', { featured: d.featured }]}>
  <div class="mosaic">
    {pics.map((p, i) => (p ? <img class={`p${i}`} src={p} alt="" width="900" height="1125" loading="lazy" /> : <div class={`p${i} empty`} />))}
    <ShareButton url={d.url} title={b.nameFa} class="share" />
    {d.featured && <span class="flag"><Icon name="star" size={14} />ویژه</span>}
  </div>
  <div class="badge" aria-hidden="true"><span>{d.letter}</span></div>
  <div class="body">
    <h3><a href={d.url}>{b.nameFa}</a></h3>
    <p class="meta">{d.category.name} در {b.neighborhood}، {d.city}</p>
    <ul class="chips">
      {b.verified && <li class="v"><Icon name="badge-check" size={15} />تأییدشده</li>}
      {b.languages.map((l) => <li>{l}</li>)}
    </ul>
    <div class="actions">
      <a class="call" href={d.tel}><Icon name="phone" />تماس</a>
      {d.wa && <a class="wa" href={d.wa} rel="noopener"><Icon name="message-circle" />واتساپ</a>}
    </div>
    <Brandmark tone="dark" />
  </div>
</article>
<style>
  .c9 { position: relative; width: 340px; max-width: 100%; aspect-ratio: 9 / 16; display: flex; flex-direction: column; border-radius: 28px; overflow: hidden; background: var(--color-bg); box-shadow: 0 0 0 1px var(--color-border), 0 30px 60px -30px rgb(11 18 41 / 40%); }
  .c9.featured { box-shadow: 0 0 0 3px var(--color-featured), 0 30px 60px -30px rgb(122 86 0 / 45%); }
  .mosaic { position: relative; flex: 1; min-height: 0; display: grid; grid-template-columns: 1.6fr 1fr; grid-template-rows: 1fr 1fr; gap: 4px; padding: 4px; }
  .mosaic img, .empty { width: 100%; height: 100%; object-fit: cover; border-radius: 22px; min-height: 0; }
  .empty { background: var(--color-primary-strong) url('/tile-dark.svg') 0 0 / 48px 48px; }
  .p0 { grid-row: span 2; border-radius: 24px 6px 6px 6px !important; }
  .p1 { border-radius: 6px 24px 6px 6px !important; }
  .p2 { border-radius: 6px !important; }
  .c9 :global(.share) { position: absolute; top: 14px; left: 14px; width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgb(255 255 255 / 92%); color: var(--color-primary-strong); display: grid; place-items: center; cursor: pointer; }
  .flag { position: absolute; top: 14px; right: 14px; display: inline-flex; align-items: center; gap: 4px; padding: 3px 12px; border-radius: 99px; background: var(--color-featured); color: #fff; font-size: .8rem; font-weight: 800; }
  .badge { position: relative; z-index: 2; align-self: center; margin-top: -40px; width: 80px; height: 80px; background: var(--color-bg); clip-path: var(--shape-star); display: grid; place-items: center; }
  .badge span { width: 66px; height: 66px; clip-path: var(--shape-star); background: var(--color-primary); color: #fff; display: grid; place-items: center; font-size: 1.9rem; font-weight: 900; padding-top: 4px; }
  .featured .badge span { background: var(--color-featured); }
  .body { padding: 4px 20px 16px; display: grid; justify-items: center; text-align: center; gap: 4px; }
  h3 { margin: 0; font-size: 1.6rem; font-weight: 900; line-height: 1.3; }
  h3 a { color: var(--color-text); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .meta { margin: 0; color: var(--color-muted); font-size: .92rem; }
  .chips { list-style: none; padding: 0; margin: 6px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .chips li { display: inline-flex; align-items: center; gap: 3px; font-size: .8rem; padding: 2px 10px; border-radius: 99px; background: var(--color-surface); color: var(--color-muted); }
  .chips .v { background: var(--color-primary-soft); color: var(--color-primary); font-weight: 700; }
  .actions { position: relative; z-index: 1; width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; }
  .actions a { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 48px; border-radius: 99px; font-weight: 800; text-decoration: none; }
  .call { background: var(--color-primary); color: #fff; }
  .call:hover { background: var(--color-primary-strong); color: #fff; }
  .wa { border: 1.5px solid var(--color-primary); color: var(--color-primary); }
  .actions a:only-child { grid-column: 1 / -1; }
  .body :global(.brandmark) { margin-top: 8px; opacity: .8; }
</style>
