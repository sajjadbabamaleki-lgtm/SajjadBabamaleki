---
// طرح ۳ — «محراب»: قوس جناغی ایرانی با نقش کاشی، دور حرف اول کسب‌وکار
import Icon from '../Icon.astro';
import ShareButton from './ShareButton.astro';
import { cardData } from './props';
import type { Business } from '../../lib/data';
interface Props { business: Business }
const d = cardData(Astro.props.business);
const { b } = d;
const id = `arch-${b.slug}`;
const arch = 'M6 236 V112 C6 66 52 34 100 6 C148 34 194 66 194 112 V236 Z';
---
<article class:list={['c3', { featured: d.featured }]}>
  <ShareButton url={d.url} title={b.nameFa} class="share" />
  <div class="arch">
    <svg viewBox="0 0 200 240" aria-hidden="true">
      <defs>
        <pattern id={id} width="32" height="32" patternUnits="userSpaceOnUse"><image href="/tile-dark.svg" width="32" height="32" /></pattern>
      </defs>
      <path d={arch} class="fill" />
      <path d={arch} fill={`url(#${id})`} />
      <path d={arch} class="stroke" />
    </svg>
    <span class="letter" aria-hidden="true">{d.letter}</span>
    {d.featured && <span class="flag"><Icon name="star" size={14} />ویژه · آگهی</span>}
  </div>
  <h3><a href={d.url}>{b.nameFa}</a></h3>
  <p class="sub"><span>{d.category.name}</span><i aria-hidden="true"></i><span>{b.neighborhood}، {d.city}</span></p>
  {b.verified && <p class="ver"><Icon name="badge-check" size={17} />تأییدشده</p>}
  <p class="desc">{b.description}</p>
  <ul class="langs">{b.languages.map((l) => <li>{l}</li>)}</ul>
  <div class="actions">
    <a class="call" href={d.tel}><Icon name="phone" />تماس</a>
    {d.wa && <a class="wa" href={d.wa} rel="noopener"><Icon name="message-circle" />واتساپ</a>}
  </div>
</article>
<style>
  .c3 { width: 340px; max-width: 100%; position: relative; padding: 28px 24px 24px; border-radius: 28px; background: var(--color-bg); box-shadow: 0 0 0 1px var(--color-border), 0 30px 60px -30px rgb(11 18 41 / 35%); display: grid; justify-items: center; text-align: center; gap: 6px; }
  .c3.featured { background: var(--color-featured-soft); box-shadow: 0 0 0 2px var(--color-featured), 0 30px 60px -30px rgb(122 86 0 / 40%); }
  .c3 :global(.share) { position: absolute; top: 14px; inset-inline-end: 14px; z-index: 2; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-primary); display: grid; place-items: center; cursor: pointer; }
  .arch { position: relative; width: 170px; height: 204px; margin-bottom: 14px; display: grid; place-items: center; }
  .arch svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fill { fill: var(--color-primary-strong); }
  .stroke { fill: none; stroke: var(--color-primary-soft); stroke-width: 6; }
  .featured .stroke { stroke: var(--color-featured); stroke-width: 7; }
  .letter { position: relative; translate: 0 18px; width: 96px; height: 96px; background: var(--color-bg); clip-path: var(--shape-star); display: grid; place-items: center; font-size: 2.6rem; font-weight: 900; color: var(--color-primary-strong); padding-top: 6px; }
  .featured .letter { color: var(--color-featured-text); }
  .flag { position: absolute; bottom: -14px; display: inline-flex; align-items: center; gap: 4px; padding: 3px 12px; border-radius: 99px; background: var(--color-featured); color: #fff; font-size: .8rem; font-weight: 800; white-space: nowrap; }
  h3 { margin: 6px 0 0; font-size: 1.6rem; font-weight: 900; }
  h3 a { color: var(--color-text); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .sub { margin: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px; color: var(--color-muted); font-size: .92rem; }
  .sub span:first-child { color: var(--color-primary); font-weight: 700; }
  .sub i { width: 6px; height: 6px; background: var(--color-featured); clip-path: var(--shape-star); }
  .ver { margin: 0; display: inline-flex; gap: 4px; align-items: center; color: var(--color-primary); font-weight: 700; font-size: .9rem; }
  .desc { margin: 6px 0 0; color: var(--color-muted); font-size: .92rem; }
  .langs { list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .langs li { font-size: .8rem; padding: 2px 10px; border-radius: 99px; border: 1px solid var(--color-border); color: var(--color-muted); background: var(--color-bg); }
  .actions { position: relative; z-index: 1; width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 14px; }
  .actions a { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 50px; border-radius: 99px; font-weight: 800; text-decoration: none; }
  .call { background: var(--color-primary); color: #fff; }
  .call:hover { background: var(--color-primary-strong); color: #fff; }
  .wa { border: 1.5px solid var(--color-primary); color: var(--color-primary); background: var(--color-bg); }
  .actions a:only-child { grid-column: 1 / -1; }
</style>
