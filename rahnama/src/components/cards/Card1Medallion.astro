---
// طرح ۱ — «مدال کاشی»: نیمه‌ی بالا سرمه‌ای با نقش کاشی و یک مدال ستاره‌ای بزرگ
import Icon from '../Icon.astro';
import ShareButton from './ShareButton.astro';
import { cardData } from './props';
import type { Business } from '../../lib/data';
interface Props { business: Business }
const d = cardData(Astro.props.business);
const { b } = d;
---
<article class:list={['c1', { featured: d.featured }]}>
  <div class="top">
    {d.featured && <span class="flag"><Icon name="star" size={14} />ویژه · آگهی</span>}
    <ShareButton url={d.url} title={b.nameFa} class="share" />
    <div class="medal" aria-hidden="true"><div class="ring"><span>{d.letter}</span></div></div>
  </div>
  <div class="body">
    <p class="cat"><Icon name={d.category.icon} size={16} />{d.category.name}</p>
    <h3><a href={d.url}>{b.nameFa}</a></h3>
    <p class="en" dir="ltr">{b.nameEn}</p>
    {b.verified && <p class="ver"><Icon name="badge-check" size={18} />تأییدشده</p>}
    <p class="loc"><Icon name="map-pin" size={16} />{b.neighborhood}، {d.city}</p>
    <ul class="langs">{b.languages.map((l) => <li>{l}</li>)}</ul>
    <div class="actions">
      <a class="call" href={d.tel}><Icon name="phone" />تماس</a>
      {d.wa && <a class="wa" href={d.wa} rel="noopener" aria-label="واتساپ"><Icon name="message-circle" /></a>}
    </div>
  </div>
</article>
<style>
  .c1 { width: 340px; max-width: 100%; border-radius: 28px; overflow: hidden; background: var(--color-bg); box-shadow: 0 30px 60px -30px rgb(11 18 41 / 45%), 0 0 0 1px var(--color-border); position: relative; }
  .top { position: relative; height: 210px; background: var(--color-primary-strong) url('/tile-dark.svg') 0 0 / 56px 56px; display: grid; place-items: center; }
  .top::after { content: ''; position: absolute; inset-inline: 0; bottom: -1px; height: 60px; background: var(--color-bg); clip-path: ellipse(70% 100% at 50% 100%); }
  .medal { position: relative; z-index: 1; translate: 0 44px; width: 150px; height: 150px; background: var(--color-bg); clip-path: var(--shape-star); display: grid; place-items: center; }
  .ring { width: 124px; height: 124px; background: var(--color-primary); clip-path: var(--shape-star); display: grid; place-items: center; }
  .ring span { color: #fff; font-size: 3.4rem; font-weight: 900; line-height: 1; translate: 0 4px; }
  .featured .medal { background: linear-gradient(135deg, #e9cf86, var(--color-featured) 45%, #f3dfa2 60%, #9c7220); }
  .featured .ring { background: var(--color-primary-strong); }
  .featured .ring span { color: #f3dfa2; }
  .flag { position: absolute; top: 16px; inset-inline-start: 16px; z-index: 2; display: inline-flex; align-items: center; gap: 4px; padding: 3px 12px; border-radius: 99px; background: var(--color-featured-soft); color: var(--color-featured-text); font-size: .8rem; font-weight: 800; border: 1px solid var(--color-featured); }
  .c1 :global(.share) { position: absolute; top: 12px; inset-inline-end: 12px; z-index: 2; width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgb(255 255 255 / 14%); color: #fff; display: grid; place-items: center; cursor: pointer; }
  .c1 :global(.share):hover { background: rgb(255 255 255 / 24%); }
  .body { padding: 56px 24px 24px; text-align: center; display: grid; justify-items: center; gap: 6px; }
  .cat { margin: 0; display: inline-flex; gap: 6px; align-items: center; color: var(--color-primary); font-weight: 700; font-size: .9rem; }
  h3 { margin: 0; font-size: 1.6rem; font-weight: 900; }
  h3 a { color: var(--color-text); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .en { margin: 0; color: var(--color-muted); font-size: .9rem; }
  .ver { margin: 0; display: inline-flex; gap: 4px; align-items: center; color: var(--color-primary); font-weight: 700; font-size: .9rem; }
  .loc { margin: 4px 0 0; display: inline-flex; gap: 4px; align-items: center; color: var(--color-muted); }
  .langs { list-style: none; padding: 0; margin: 6px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .langs li { font-size: .8rem; padding: 2px 10px; border-radius: 99px; background: var(--color-surface); color: var(--color-muted); }
  .actions { position: relative; z-index: 1; width: 100%; display: flex; gap: 8px; margin-top: 14px; }
  .call { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; border-radius: 99px; background: var(--color-primary); color: #fff; font-weight: 800; text-decoration: none; font-size: 1.05rem; }
  .call:hover { background: var(--color-primary-strong); color: #fff; }
  .wa { width: 52px; height: 52px; flex: none; display: grid; place-items: center; border-radius: 50%; border: 1.5px solid var(--color-primary); color: var(--color-primary); }
  .wa:hover { background: var(--color-primary-soft); }
  .featured { box-shadow: 0 30px 60px -30px rgb(122 86 0 / 45%), 0 0 0 2px var(--color-featured); }
</style>
