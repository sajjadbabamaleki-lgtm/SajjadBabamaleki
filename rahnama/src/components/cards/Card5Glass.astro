---
// طرح ۵ — «شیشه روی کاشی»: پس‌زمینه‌ی سرمه‌ای با نور ملایم و یک لایه‌ی شیشه‌ای روی نقش کاشی
import Icon from '../Icon.astro';
import ShareButton from './ShareButton.astro';
import { cardData } from './props';
import type { Business } from '../../lib/data';
interface Props { business: Business }
const d = cardData(Astro.props.business);
const { b } = d;
---
<article class:list={['c5', { featured: d.featured }]}>
  <div class="glow" aria-hidden="true"></div>
  <header>
    {d.featured ? <span class="flag"><Icon name="star" size={14} />ویژه · آگهی</span> : <span></span>}
    <ShareButton url={d.url} title={b.nameFa} class="share" />
  </header>
  <div class="glass">
    <div class="avatar" aria-hidden="true"><span>{d.letter}</span></div>
    <h3><a href={d.url}>{b.nameFa}</a></h3>
    <p class="en" dir="ltr">{b.nameEn}</p>
    <ul class="chips">
      <li><Icon name={d.category.icon} size={15} />{d.category.name}</li>
      <li><Icon name="map-pin" size={15} />{b.neighborhood}</li>
      {b.verified && <li class="v"><Icon name="badge-check" size={15} />تأییدشده</li>}
    </ul>
    <p class="langs"><Icon name="languages" size={16} />{b.languages.join(' · ')}</p>
  </div>
  <div class="actions">
    <a class="call" href={d.tel}><Icon name="phone" />تماس</a>
    {d.wa && <a class="wa" href={d.wa} rel="noopener"><Icon name="message-circle" />واتساپ</a>}
  </div>
</article>
<style>
  .c5 { --accent: #a9bce8; width: 340px; max-width: 100%; position: relative; overflow: hidden; isolation: isolate; padding: 16px 16px 18px; border-radius: 30px; background: var(--color-ink) url('/tile-dark.svg') 0 0 / 60px 60px; color: #fff; box-shadow: 0 30px 70px -30px rgb(11 18 41 / 70%); display: grid; gap: 14px; }
  .c5.featured { --accent: #f0d68e; }
  .glow { position: absolute; z-index: -1; width: 320px; height: 320px; top: -90px; left: 50%; translate: -50% 0; border-radius: 50%; background: radial-gradient(circle, rgb(69 103 196 / 75%), transparent 65%); }
  .featured .glow { background: radial-gradient(circle, rgb(201 165 74 / 55%), transparent 65%); }
  .bigstar { position: absolute; z-index: -1; width: 260px; height: 260px; bottom: -120px; inset-inline-start: -110px; background: rgb(255 255 255 / 5%); clip-path: var(--shape-star); }
  header { display: flex; justify-content: space-between; align-items: center; }
  .flag { display: inline-flex; align-items: center; gap: 4px; padding: 3px 12px; border-radius: 99px; background: rgb(240 214 142 / 18%); color: #f0d68e; border: 1px solid rgb(240 214 142 / 55%); font-size: .8rem; font-weight: 800; }
  .c5 :global(.share) { width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgb(255 255 255 / 20%); background: rgb(255 255 255 / 8%); color: #fff; display: grid; place-items: center; cursor: pointer; backdrop-filter: blur(6px); }
  .glass { display: grid; justify-items: center; text-align: center; gap: 4px; padding: 26px 18px 20px; border-radius: 22px; background: rgb(255 255 255 / 8%); border: 1px solid rgb(255 255 255 / 16%); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .avatar { width: 104px; height: 104px; display: grid; place-items: center; background: var(--accent); clip-path: var(--shape-star); margin-bottom: 10px; }
  .avatar span { width: 90px; height: 90px; display: grid; place-items: center; clip-path: var(--shape-star); background: var(--color-primary); font-size: 2.6rem; font-weight: 900; color: #fff; padding-top: 6px; }
  h3 { margin: 0; font-size: 1.6rem; font-weight: 900; }
  h3 a { color: #fff; text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .en { margin: 0; color: rgb(255 255 255 / 70%); font-size: .9rem; }
  .chips { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .chips li { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 99px; background: rgb(255 255 255 / 10%); font-size: .82rem; font-weight: 600; }
  .chips .v { color: var(--accent); }
  .langs { margin: 8px 0 0; display: inline-flex; align-items: center; gap: 6px; font-size: .85rem; color: rgb(255 255 255 / 78%); }
  .actions { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .actions a { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 52px; border-radius: 99px; font-weight: 800; text-decoration: none; }
  .call { background: #fff; color: var(--color-primary-strong); }
  .call:hover { background: var(--color-primary-soft); color: var(--color-primary-strong); }
  .featured .call { background: linear-gradient(135deg, #f3dfa2, #c9a54a); color: #3d2a00; }
  .wa { background: rgb(255 255 255 / 10%); border: 1px solid rgb(255 255 255 / 25%); color: #fff; }
  .wa:hover { background: rgb(255 255 255 / 18%); color: #fff; }
  .actions a:only-child { grid-column: 1 / -1; }
</style>
