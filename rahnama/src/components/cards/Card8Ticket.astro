---
// طرح ۸ «بلیت»: عکس بالا، خط پرفراژ با دو بریدگی، اطلاعات مثل بلیت
import Icon from '../Icon.astro';
import ShareButton from './ShareButton.astro';
import Brandmark from './Brandmark.astro';
import { cardData } from './props';
import type { Business } from '../../lib/data';
interface Props { business: Business }
const d = cardData(Astro.props.business);
const { b } = d;
---
<article class:list={['c8', { featured: d.featured }]}>
  <div class="photo">
    {d.cover ? <img src={d.cover} alt="" width="900" height="1125" loading="lazy" /> : <div class="fallback" />}
    <div class="top">
      {d.featured ? <span class="flag"><Icon name="star" size={14} />ویژه</span> : <span />}
      <ShareButton url={d.url} title={b.nameFa} class="share" />
    </div>
    <span class="cat"><Icon name={d.category.icon} size={16} />{d.category.name}</span>
  </div>
  <div class="stub">
    <h3><a href={d.url}>{b.nameFa}</a></h3>
    <p class="en" dir="ltr">{b.nameEn}</p>
    <dl>
      <div><dt>محله</dt><dd>{b.neighborhood}</dd></div>
      <div><dt>شهر</dt><dd>{d.city}</dd></div>
      <div><dt>زبان</dt><dd>{b.languages.slice(0, 2).join('، ')}</dd></div>
      <div><dt>وضعیت</dt><dd>{b.verified ? <span class="ver"><Icon name="badge-check" size={15} />تأییدشده</span> : 'ثبت پایه'}</dd></div>
    </dl>
    <div class="tear" aria-hidden="true"></div>
    <div class="actions">
      <a class="call" href={d.tel}><Icon name="phone" />تماس</a>
      {d.wa && <a class="wa" href={d.wa} rel="noopener"><Icon name="message-circle" />واتساپ</a>}
    </div>
    <Brandmark tone="dark" />
  </div>
</article>
<style>
  .c8 { --notch: 14px; width: 340px; max-width: 100%; aspect-ratio: 9 / 16; display: flex; flex-direction: column; filter: drop-shadow(0 24px 30px rgb(11 18 41 / 22%)); }
  .photo { position: relative; flex: 1; min-height: 0; border-radius: 24px 24px 0 0; overflow: hidden; background: var(--color-primary-strong); }
  .photo img, .fallback { width: 100%; height: 100%; object-fit: cover; }
  .fallback { background: var(--color-primary-strong) url('/tile-dark.svg') 0 0 / 64px 64px; }
  .top { position: absolute; inset: 14px 14px auto; display: flex; justify-content: space-between; align-items: center; }
  .flag { display: inline-flex; align-items: center; gap: 4px; padding: 3px 12px; border-radius: 99px; background: var(--color-featured); color: #fff; font-size: .8rem; font-weight: 800; }
  .c8 :global(.share) { width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgb(255 255 255 / 92%); color: var(--color-primary-strong); display: grid; place-items: center; cursor: pointer; }
  .cat { position: absolute; bottom: 14px; inset-inline-start: 14px; display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 99px; background: var(--color-bg); color: var(--color-primary-strong); font-weight: 800; font-size: .9rem; }
  .stub { position: relative; background: var(--color-bg); border-radius: 0 0 24px 24px; padding: 18px 20px 16px; display: grid; gap: 4px;
    -webkit-mask: radial-gradient(circle var(--notch) at 0 calc(100% - 92px), transparent 98%, #000) , radial-gradient(circle var(--notch) at 100% calc(100% - 92px), transparent 98%, #000);
    -webkit-mask-composite: source-in; mask: radial-gradient(circle var(--notch) at 0 calc(100% - 92px), transparent 98%, #000), radial-gradient(circle var(--notch) at 100% calc(100% - 92px), transparent 98%, #000); mask-composite: intersect; }
  .featured .stub { background: var(--color-featured-soft); }
  h3 { margin: 0; font-size: 1.6rem; font-weight: 900; line-height: 1.3; }
  h3 a { color: var(--color-text); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .en { margin: 0; color: var(--color-muted); font-size: .85rem; text-align: start; }
  dl { margin: 10px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px; }
  dt { font-size: .72rem; color: var(--color-muted); }
  dd { margin: 0; font-weight: 800; font-size: .92rem; }
  .ver { display: inline-flex; align-items: center; gap: 3px; color: var(--color-primary); }
  .tear { height: 0; border-top: 2px dashed var(--color-border-strong); opacity: .5; margin: 12px calc(var(--notch) * -1 + 6px) 10px; }
  .actions { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .actions a { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 48px; border-radius: 14px; font-weight: 800; text-decoration: none; }
  .call { background: var(--color-primary); color: #fff; }
  .call:hover { background: var(--color-primary-strong); color: #fff; }
  .wa { border: 1.5px solid var(--color-primary); color: var(--color-primary); }
  .actions a:only-child { grid-column: 1 / -1; }
  .stub :global(.brandmark) { justify-self: center; margin-top: 8px; opacity: .8; }
</style>
