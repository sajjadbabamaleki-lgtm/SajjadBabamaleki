---
import Icon from './Icon.astro';
export interface Crumb { name: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
const all: Crumb[] = [{ name: 'خانه', href: '/' }, ...items];
---
<nav class="breadcrumb" aria-label="مسیر صفحه">
  <ol>
    {all.map((c, i) => (
      <li>
        {i > 0 && <Icon name="chevron-left" size={14} class="sep" />}
        {c.href && i < all.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .breadcrumb ol { list-style: none; margin: 0; padding: var(--space-3) 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-2); font-size: var(--text-sm); color: var(--color-muted); }
  .breadcrumb li { display: inline-flex; align-items: center; gap: var(--space-2); }
  .breadcrumb a { color: var(--color-muted); text-decoration: none; padding-block: var(--space-2); }
  .breadcrumb a:hover { color: var(--color-primary); text-decoration: underline; }
  .breadcrumb [aria-current] { color: var(--color-text); font-weight: 600; }
  .breadcrumb :global(.sep) { opacity: .6; }
</style>
