---
export interface Crumb { name: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
const all: Crumb[] = [{ name: 'خانه', href: '/' }, ...items];
---
<nav class="breadcrumb" aria-label="مسیر صفحه">
  <ol>
    {all.map((c, i) => (
      <li>
        {c.href && i < all.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .breadcrumb ol { list-style: none; margin: 1rem 0; padding: 0; display: flex; flex-wrap: wrap; gap: .25rem; font-size: .9rem; color: var(--color-muted); }
  .breadcrumb li + li::before { content: '←'; margin-inline-end: .25rem; }
  .breadcrumb a { color: var(--color-muted); }
</style>
