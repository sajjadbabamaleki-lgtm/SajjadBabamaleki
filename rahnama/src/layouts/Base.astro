---
import '@fontsource-variable/vazirmatn';
import '../styles/tokens.css';
import '../styles/base.css';
import Breadcrumb, { type Crumb } from '../components/Breadcrumb.astro';
import { SITE_NAME } from '../lib/site';
import { publishedCities } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  breadcrumb?: Crumb[];
  noindex?: boolean;
}
const { title, description = '', breadcrumb, noindex = false } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="logo" href="/">{SITE_NAME}</a>
        <nav aria-label="منوی اصلی">
          <a href="/business-add/">ثبت رایگان</a>
          <a href="/featured/">ثبت ویژه</a>
          <a href="/services/">خدمات</a>
        </nav>
      </div>
    </header>
    <main class="container">
      {breadcrumb && <Breadcrumb items={breadcrumb} />}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <nav aria-label="شهرها">
          {publishedCities.map((c) => <a href={`/${c.slug}/`}>{c.name}</a>)}
        </nav>
        <nav aria-label="صفحه‌های پایه">
          <a href="/about/">درباره‌ی ما</a>
          <a href="/contact/">تماس</a>
          <a href="/terms/">شرایط استفاده</a>
          <a href="/privacy/">حریم خصوصی</a>
          <a href="/impressum/">Impressum</a>
        </nav>
        <p>© {new Date().getFullYear()} {SITE_NAME}</p>
      </div>
    </footer>
  </body>
</html>
<style>
  .site-header { border-bottom: 1px solid var(--color-border); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; padding-block: .75rem; }
  .logo { font-weight: 800; font-size: 1.15rem; color: var(--color-text); text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; gap: .25rem 1rem; }
  main { min-height: 60vh; padding-bottom: 3rem; }
  .site-footer { background: var(--color-surface); border-top: 1px solid var(--color-border); padding-block: 1.5rem; font-size: .9rem; color: var(--color-muted); }
  .site-footer nav { margin-bottom: .75rem; }
</style>
