---
import '@fontsource-variable/vazirmatn';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb, { type Crumb } from '../components/Breadcrumb.astro';
import { SITE_NAME } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  breadcrumb?: Crumb[];
  noindex?: boolean;
}
const { title, description = '', breadcrumb, noindex = false } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#1b2f6b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">رفتن به محتوای اصلی</a>
    <Header />
    <main id="main">
      {breadcrumb && <div class="container"><Breadcrumb items={breadcrumb} /></div>}
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style>
  .skip { position: absolute; inset-inline-start: var(--space-4); top: -100px; z-index: 100; background: var(--color-primary); color: var(--color-on-primary); padding: var(--space-2) var(--space-4); border-radius: var(--radius-sm); }
  .skip:focus { top: var(--space-2); }
  main { min-height: 60vh; }
</style>
