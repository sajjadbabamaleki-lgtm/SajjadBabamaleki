---
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
---
<Page title="تماس با ما" eyebrow="تماس" icon="mail" lead="سؤال، پیشنهاد یا گزارش اشتباه؟ خوشحال می‌شویم بشنویم.">
  <div class="prose">
    <p id="report-note" hidden class="note">برای گزارش اشتباه، اسم کسب‌وکار و مورد اشتباه را برایمان بفرستید.</p>
    <p class="note">راه تماس (ایمیل یا واتساپ) بعد از انتخاب، اینجا قرار می‌گیرد.</p>
    <p><a class="btn btn-primary" href="/business-add/"><Icon name="plus" />ثبت رایگان کسب‌وکار</a></p>
  </div>
</Page>
<script>
  if (new URLSearchParams(location.search).has('report')) document.getElementById('report-note')!.hidden = false;
</script>
