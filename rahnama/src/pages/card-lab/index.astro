---
// صفحه‌ی موقت برای انتخاب طرح کارت. بعد از انتخاب حذف می‌شود.
import Base from '../../layouts/Base.astro';
import Card1 from '../../components/cards/Card1Medallion.astro';
import Card2 from '../../components/cards/Card2Royal.astro';
import Card3 from '../../components/cards/Card3Mihrab.astro';
import Card4 from '../../components/cards/Card4Editorial.astro';
import Card5 from '../../components/cards/Card5Glass.astro';
import { businesses } from '../../lib/data';
const featured = businesses.find((b) => b.slug === 'dr-sample-one')!;
const normal = businesses.find((b) => b.slug === 'dr-sample-two')!;
const designs = [
  { n: '۱', id: 'd1', name: 'مدال کاشی', note: 'نیمه‌ی بالا سرمه‌ای با نقش کاشی؛ یک مدال ستاره‌ای بزرگ وسط کارت. گرم، آشنا و مناسب همه‌ی تخصص‌ها.', C: Card1 },
  { n: '۲', id: 'd2', name: 'کارت شاهانه', note: 'تمام سرمه‌ای با قاب داخلی ظریف و ستاره‌های گوشه، مثل کارت ویزیت لوکس. برای ویژه‌ها قاب و دکمه طلایی می‌شود.', C: Card2 },
  { n: '۳', id: 'd3', name: 'محراب', note: 'قوس جناغی ایرانی با نقش کاشی دور حرف اول. ایرانی‌ترین طرح؛ در استوری خیلی به چشم می‌آید.', C: Card3 },
  { n: '۴', id: 'd4', name: 'مجله‌ای', note: 'تایپوگرافی درشت، شماره‌ی ردیف و خط‌کشی ظریف. مدرن و جدی؛ مناسب وکیل، حسابدار و پزشک.', C: Card4 },
  { n: '۵', id: 'd5', name: 'شیشه روی کاشی', note: 'سرمه‌ای تیره با نور ملایم و لایه‌ی شیشه‌ای. پرزرق‌وبرق‌ترین طرح؛ برای ویژه‌ها نور طلایی می‌گیرد.', C: Card5 },
];
---
<Base title="انتخاب طرح کارت" noindex breadcrumb={[{ name: 'انتخاب طرح کارت' }]}>
  <div class="container lab">
    <h1>۵ طرح برای کارت کسب‌وکار</h1>
    <p class="lead">هر طرح دو بار آمده: راست کسب‌وکار <b>ویژه</b>، چپ کسب‌وکار <b>معمولی</b>. همه عمودی هستند تا در قاب استوری جا شوند.</p>
    {designs.map(({ n, id, name, note, C }) => (
      <section class="design" id={id}>
        <div class="label"><span class="n">{n}</span><div><h2>{name}</h2><p>{note}</p></div></div>
        <div class="stage">
          <C business={featured} index={1} />
          <C business={normal} index={2} />
        </div>
      </section>
    ))}
  </div>
</Base>
<style>
  .lab { padding-block: var(--space-5) var(--space-8); }
  .lead { color: var(--color-muted); font-size: var(--text-lg); }
  .design { margin-top: var(--space-7); }
  .label { display: flex; gap: var(--space-4); align-items: flex-start; margin-bottom: var(--space-4); }
  .label .n { flex: none; width: 52px; height: 52px; display: grid; place-items: center; background: var(--color-primary); color: #fff; clip-path: var(--shape-star); font-weight: 900; font-size: 1.3rem; }
  .label h2 { margin: 0; }
  .label p { margin: 0; color: var(--color-muted); max-width: 46rem; }
  .stage { display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; gap: var(--space-6); padding: var(--space-7) var(--space-4); border-radius: var(--radius-lg); background: var(--color-surface) var(--tile-light) 0 0 / 64px 64px; }
</style>
