---
// صفحه‌ی موقت برای انتخاب طرح کارت. بعد از انتخاب حذف می‌شود.
import Base from '../../layouts/Base.astro';
import Card6 from '../../components/cards/Card6Poster.astro';
import Card7 from '../../components/cards/Card7Arch.astro';
import Card8 from '../../components/cards/Card8Ticket.astro';
import Card9 from '../../components/cards/Card9Collage.astro';
import Card10 from '../../components/cards/Card10Cover.astro';
import { businesses } from '../../lib/data';
const featured = businesses.find((b) => b.slug === 'dr-sample-one')!;
const normal = businesses.find((b) => b.slug === 'sample-restaurant')!;
const designs = [
  { n: '۶', id: 'd6', name: 'پوستر', note: 'عکس تمام‌قد و اسم درشت روی عکس، مثل یک استوری آماده. نشان سایت بالای کارت است تا هر اشتراک‌گذاری، سایت را هم معرفی کند.', C: Card6 },
  { n: '۷', id: 'd7', name: 'پنجره‌ی محراب', note: 'عکس کسب‌وکار داخل قوس جناغی ایرانی، با قاب دولایه روی زمینه‌ی سرمه‌ای کاشی. برای ویژه‌ها قاب طلایی.', C: Card7 },
  { n: '۸', id: 'd8', name: 'بلیت', note: 'عکس بالا و اطلاعات پایین مثل بلیت، با خط پرفراژ و دو بریدگی کنار. بازیگوش و به‌یادماندنی.', C: Card8 },
  { n: '۹', id: 'd9', name: 'کلاژ', note: 'سه عکس کنار هم، با ستاره‌ی لوگو روی مرز عکس‌ها. برای کسب‌وکارهایی که عکس خوب دارند (رستوران، سالن زیبایی).', C: Card9 },
  { n: '۱۰', id: 'd10', name: 'جلد مجله', note: 'اسم سایت مثل تیتر مجله، خدمات مثل تیترهای روی جلد، و برچسب ستاره‌ای برای ویژه‌ها.', C: Card10 },
];
---
<Base title="انتخاب طرح کارت" noindex breadcrumb={[{ name: 'انتخاب طرح کارت' }]}>
  <div class="container lab">
    <h1>۵ طرح تازه برای کارت کسب‌وکار</h1>
    <p class="lead">هر طرح دو بار آمده: راست کسب‌وکار <b>ویژه</b>، چپ کسب‌وکار <b>معمولی</b>. همه عمودی هستند تا در قاب استوری جا شوند.</p>
    {designs.map(({ n, id, name, note, C }) => (
      <section class="design" id={id}>
        <div class="label"><span class="n">{n}</span><div><h2>{name}</h2><p>{note}</p></div></div>
        <div class="stage">
          <C business={featured} />
          <C business={normal} />
        </div>
      </section>
    ))}
  </div>
</Base>
<style>
  .lab { padding-block: var(--space-5) var(--space-8); }
  .lead { color: var(--color-muted); font-size: var(--text-lg); }
  .design { margin-top: var(--space-7); }
  .label { display: flex; gap: var(--space-4); align-items: flex-start; margin-bottom: var(--space-4); }
  .label .n { flex: none; width: 52px; height: 52px; display: grid; place-items: center; background: var(--color-primary); color: #fff; clip-path: var(--shape-star); font-weight: 900; font-size: 1.3rem; }
  .label h2 { margin: 0; }
  .label p { margin: 0; color: var(--color-muted); max-width: 46rem; }
  .stage { display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; gap: var(--space-6); padding: var(--space-7) var(--space-4); border-radius: var(--radius-lg); background: var(--color-surface) var(--tile-light) 0 0 / 64px 64px; }
</style>
