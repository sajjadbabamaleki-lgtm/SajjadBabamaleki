---
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
const services = [
  { icon: 'palette', t: 'برند بوک', d: 'لوگو، رنگ‌ها، فونت و قواعد استفاده؛ تا کسب‌وکارتان همه‌جا یک شکل و حرفه‌ای دیده شود.' },
  { icon: 'monitor-smartphone', t: 'ساخت سایت', d: 'سایت سریع، دوزبانه و مناسب موبایل که در گوگل پیدا شود.' },
  { icon: 'video', t: 'ویدیوی تبلیغاتی', d: 'ویدیوهای کوتاه برای اینستاگرام و تبلیغ، به فارسی و زبان محلی.' },
];
---
<Page title="خدمات برند" eyebrow="برای کسب‌وکارها" icon="sparkles" lead="برند بوک، سایت و ویدیو؛ همه از یک جا، برای کسب‌وکارهای ایرانی خارج از کشور.">
  <div class="services">
    {services.map((s, i) => (
      <section class="svc">
        <span class="num">{(i + 1).toLocaleString('fa-IR')}</span>
        <span class="si"><Icon name={s.icon} size={26} /></span>
        <h2>{s.t}</h2>
        <p>{s.d}</p>
        <div class="portfolio" aria-label="جای نمونه‌کار"><Icon name="layers" size={20} />جای نمونه‌کار</div>
      </section>
    ))}
  </div>
  <p class="cta"><a class="btn btn-primary" href="/contact/"><Icon name="message-circle" />درخواست مشاوره</a></p>
</Page>
<style>
  .services { display: grid; gap: var(--space-5); }
  @media (min-width: 900px) { .services { grid-template-columns: repeat(3, 1fr); } }
  .svc { position: relative; padding: var(--space-6) var(--space-5) var(--space-5); border-top: 3px solid var(--color-primary); background: var(--color-surface); border-radius: 0 0 var(--radius-lg) var(--radius-lg); display: flex; flex-direction: column; }
  .num { position: absolute; top: var(--space-4); inset-inline-end: var(--space-5); font-size: var(--text-3xl); font-weight: 900; color: var(--color-border); line-height: 1; }
  .si { width: 56px; height: 56px; display: grid; place-items: center; background: var(--color-bg); color: var(--color-primary); clip-path: var(--shape-star); margin-bottom: var(--space-4); }
  h2 { margin-top: 0 !important; }
  p { color: var(--color-muted); }
  .portfolio { margin-top: auto; aspect-ratio: 16 / 9; display: grid; place-content: center; justify-items: center; gap: var(--space-1); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-sm); color: var(--color-muted); font-size: var(--text-sm); background: var(--color-bg) url('/tile-light.svg') 0 0 / 48px 48px; }
  .cta { margin-top: var(--space-7); }
</style>
