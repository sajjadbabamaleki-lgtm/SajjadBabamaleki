---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
---
<Base title="ممنون از ثبت شما" noindex breadcrumb={[{ name: 'ثبت رایگان', href: '/business-add/' }, { name: 'ممنون' }]}>
  <section class="container section thanks">
    <span class="ok" aria-hidden="true"><Icon name="check" size={44} /></span>
    <h1>اطلاعات شما رسید</h1>
    <p>بعد از بررسی، صفحه‌ی کسب‌وکارتان منتشر می‌شود و خبرتان می‌کنیم.</p>
    <div class="next">
      <h2><Icon name="camera" />قدم بعد: لوگو و عکس</h2>
      <p>لوگو و تا ۳ عکس از کسب‌وکارتان را از طریق واتساپ برای ما بفرستید.</p>
    </div>
    <a class="btn btn-ghost" href="/"><Icon name="arrow-left" />بازگشت به صفحه‌ی اصلی</a>
  </section>
</Base>
<style>
  .thanks { text-align: center; max-width: 36rem; display: grid; justify-items: center; }
  .ok { width: 110px; height: 110px; display: grid; place-items: center; background: var(--color-primary); color: #fff; clip-path: var(--shape-star); margin-bottom: var(--space-5); }
  .thanks > p { color: var(--color-muted); font-size: var(--text-lg); }
  .next { width: 100%; background: var(--color-surface); border-radius: var(--radius-lg); padding: var(--space-5); margin-block: var(--space-4) var(--space-6); }
  .next h2 { display: flex; align-items: center; justify-content: center; gap: var(--space-2); font-size: var(--text-lg); }
  .next p { margin: 0; color: var(--color-muted); }
</style>
